[Unit]
Description=SKVM PANEL Web (Gunicorn + Eventlet, SocketIO console)
After=network-online.target docker.service incus.service
Wants=network-online.target

[Service]
Type=simple
User=skvm-panel
Group=skvm-panel
WorkingDirectory=/opt/skvm-panel
Environment=PYTHONPATH=/opt/skvm-panel
EnvironmentFile=-/etc/skvm-panel/skvm.env
ExecStart=/opt/skvm-panel/venv/bin/gunicorn --worker-class eventlet --workers 1 --bind 0.0.0.0:5555 --timeout 120 --access-logfile - --error-logfile - app:app
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/skvm-panel /etc/skvm-panel

[Install]
WantedBy=multi-user.target
