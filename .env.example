# =============================================================================
# SKVM · environment
#
# Copy to `.env` (or let `bash autosetup.sh` generate it) — every value below
# is optional; the defaults in `skvm/config.py` are sane for a single-host
# install.  `autosetup.sh` rewrites the managed keys and keeps anything custom
# you add at the bottom.
#
# `.env` is read before the config object is built, so it applies to every
# entry point (`manage.py …`, the worker, the web server).  A real environment
# variable always wins over the file.
# =============================================================================

# ---------------------------------------------------------------- identity --
#SKVM_PANEL_NAME=SKVM
#SKVM_PANEL_TAGLINE=Sovereign Cloud Control
# Absolute base URL of the panel — used in e-mails, API links and QR codes.
# Inside rigbox / CodeSandbox / Codespaces this is detected automatically.
#SKVM_PANEL_URL=https://panel.example.com
#SKVM_SUPPORT_EMAIL=support@example.com
#SKVM_BRAND_ACCENT=#7c5cff

# ------------------------------------------------------------------ runtime --
# production | development | testing  (development enables the reloader; never
# use it where strangers can reach the port — the Werkzeug debugger runs code)
#SKVM_ENV=production
# Where the sqlite file, generated keys, backups and snapshots live.
# Put it on a persistent volume so re-deploys keep your data.
#SKVM_INSTANCE_DIR=./instance
#SKVM_TIMEZONE=UTC
#SKVM_TEMPLATE_RELOAD=false

# ------------------------------------------------------------------ secrets --
# Leave blank and autosetup/the app will generate 0600 files inside
# SKVM_INSTANCE_DIR (secret_key, encryption_key).  Set them explicitly when the
# instance directory is not persistent, otherwise sessions and stored root
# passwords cannot survive a rebuild.
#SKVM_SECRET_KEY=
# Fernet key (base64, 44 chars) that encrypts VPS root passwords + node keys.
#SKVM_ENCRYPTION_KEY=

# ----------------------------------------------------------------- network --
# Cookie security + redirects when the sandbox/platform terminates TLS.
#SKVM_COOKIE_SECURE=true
#SKVM_FORCE_HTTPS=true
#SKVM_HSTS=false
# 1 = one reverse proxy in front (rigbox/CodeSandbox add another hop → 2 is safe)
#SKVM_TRUSTED_PROXY_COUNT=2
#SKVM_MAX_UPLOAD_MB=512
#SKVM_CSRF=true

# -------------------------------------------------------------------- auth --
#SKVM_PASSWORD_MIN_LENGTH=10
#SKVM_LOGIN_MAX_ATTEMPTS=8
#SKVM_LOGIN_LOCKOUT_SECONDS=900
#SKVM_SESSION_LIFETIME=43200
# Self-signup, approval queues and 2FA enforcement for staff live in
# Admin → Settings (database-backed, hot-reloaded); these env values only seed
# the first run.
#SKVM_ALLOW_REGISTRATION=true
#SKVM_REQUIRE_EMAIL_VERIFICATION=false
#SKVM_REQUIRE_ADMIN_APPROVAL=false

# --------------------------------------------------------------- database ---
# Default: sqlite inside the instance dir.  Postgres example:
#SKVM_DATABASE_URL=postgresql+psycopg://skvm:skvm@127.0.0.1:5432/skvm
#SKVM_SQL_ECHO=false

# --------------------------------------------------------------- hypervisor --
# auto (docker if the daemon answers, else the simulated driver) | docker | demo | node
#SKVM_BACKEND=auto
#DOCKER_HOST=unix:///var/run/docker.sock
#SKVM_DOCKER_TLS_VERIFY=false
#SKVM_DOCKER_CERT_PATH=
# Where VM images / server root filesystems / backups are stored.
#SKVM_IMAGE_DIR=./vm-images
#SKVM_SERVER_ROOT=/var/lib/skvm/servers

# ------------------------------------------------------------ provisioning --
#SKVM_DEFAULT_CPU=2
#SKVM_DEFAULT_RAM_MB=4096
#SKVM_DEFAULT_DISK_GB=50
#SKVM_MAX_CPU=32
#SKVM_MAX_RAM_MB=131072
#SKVM_MAX_DISK_GB=2000
#SKVM_SNAPSHOT_LIMIT=5
#SKVM_ALLOW_CONSOLE=true
#SKVM_CONSOLE_IDLE_TIMEOUT=900
#SKVM_MAX_UPLOAD_FILES=25
# Per-user ceilings (Admin → Users can override for a single account)
#SKVM_USER_SERVER_LIMIT=5
#SKVM_USER_CPU_LIMIT=16
#SKVM_USER_RAM_LIMIT=32768
#SKVM_USER_DISK_LIMIT=500

# ------------------------------------------------------------ observability --
#SKVM_METRIC_INTERVAL=15
#SKVM_METRIC_RETENTION_DAYS=30
#SKVM_ALERT_INTERVAL=30
# Run the sampler/alert/expiry worker inside the web process. Set to 0 when you
# run `python manage.py worker` as a separate service.
#SKVM_REAPER=1
#SKVM_PROMETHEUS=true
#SKVM_PROMETHEUS_TOKEN=

# --------------------------------------------------------------------- mail --
# log = write to stdout (default, nothing is sent) | smtp | console
#SKVM_MAIL_MODE=log
#SKVM_SMTP_HOST=
#SKVM_SMTP_PORT=587
#SKVM_SMTP_USER=
#SKVM_SMTP_PASSWORD=
#SKVM_SMTP_TLS=true
#SKVM_SMTP_FROM=SKVM <no-reply@example.com>

# ------------------------------------------------------------ rate limiting --
#SKVM_RATELIMIT_DEFAULT=600 per minute
#SKVM_RATELIMIT_STORAGE=memory://

# ----------------------------------------------------------------- TLS/serve --
# Only read by `manage.py serve` when you terminate TLS yourself.
#SKVM_TLS_CERT=
#SKVM_TLS_KEY=

# ------------------------------------------------------------ autosetup.sh ---
# Knobs the bootstrap script itself reads (all overridable by flags too).
#SKVM_PORT=8080
#SKVM_DIR=~/skvm
#SKVM_REPO_URL=https://github.com/SKYDO234/SKVM.git
#SKVM_REPO_REF=main
#SKVM_ADMIN_USER=admin
#SKVM_ADMIN_PASSWORD=admin123
#SKVM_PUBLIC_URL=
#SKVM_APP_NAME=skvm

# ------------------------------------------------------- github / codespaces --
# A Codespace or a GitHub Actions runner is a *testing* box: the forwarded port
# is private until you publish it, and the codespace volume disappears with the
# codespace.  Nothing here is needed for Codespaces itself - autosetup detects
# CODESPACES / CODESPACE_NAME and builds the https://<name>-8080.app.github.dev
# URL (secure cookies + HTTPS enforcement) on its own.
#   bash autosetup.sh --expose      # gh codespace ports visibility 8080:public
# Store SKVM_ADMIN_PASSWORD as a Codespaces secret (repo Settings → Codespaces →
# Secrets) and it arrives as an environment variable - the bootstrap uses it
# instead of generating one.
#SKVM_ADMIN_USERNAME=admin
#SKVM_ADMIN_PASSWORD=
#
# The published images (ghcr.io/<owner>/skvm) read the same keys; /data is the
# state dir, so mount a volume there.
#SKVM_BACKEND=auto            # auto | docker | demo | node
#SKVM_ALLOW_REGISTRATION=false
#SKVM_SHARE_PORT=1            # entrypoint: run autosetup with --expose
#SKVM_EXTRA_ARGS="--no-demo"  # entrypoint: extra autosetup flags

# --------------------------------------------------- container / CI knobs ----
# Only read by autosetup.sh:
#SKVM_VENV=/opt/venv           # reuse a pre-built virtualenv
#SKVM_IN_CONTAINER=1           # no apt, no clone, no pip install
#SKVM_CONTAINER_APT=1          # opt out of the container defaults
#SKVM_REPO_URL=https://github.com/SKYDO234/SKVM.git
#SKVM_REPO_REF=main
