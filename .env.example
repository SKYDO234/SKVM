# SKVM PANEL — copy to .env for local/dev runs (production uses /etc/skvm-panel/skvm.env)
# You do NOT need to invent these values: install.sh writes a generated
# SECRET_KEY + SKVM_ADMIN_* into /etc/skvm-panel/skvm.env, and run.sh
# auto-creates this .env (generated SECRET_KEY + admin login) on first run.
SECRET_KEY=
SKVM_PORT=5555
SKVM_BIND=0.0.0.0
SKVM_BACKEND=auto
SKVM_HOSTNAME=skvm-node-1
SKVM_DATA_DIR=./data
SKVM_DB=./data/skvm.db
SKVM_TIMEZONE=UTC
# First-run admin (optional; otherwise random -> data/first_admin_credentials.txt)
# SKVM_ADMIN_USERNAME=admin
# SKVM_ADMIN_PASSWORD=admin123
# SKVM_COOKIE_SECURE=true   # enable behind HTTPS
# SKVM_TRUST_PROXY=true     # enable behind Nginx/Caddy

# Container / cloud-dev environments (Codespaces, rigbox, CodeSandbox):
# SKVM_PORT=5555              # forward this port in your platform
# DOCKER_HOST=                # auto-detected: docker socket, else Podman
#                             # socket; set explicitly if your daemon is
#                             # elsewhere (e.g. tcp://dind:2375)
